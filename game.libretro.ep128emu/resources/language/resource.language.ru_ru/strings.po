msgid "Options affecting emulation accuracy and enhancements."
msgstr "Параметры, влияющие на точность эмуляции и улучшения."

msgctxt "#30045"
msgid "Enable intelligent zoom function."
msgstr "Включить функцию умного масштабирования."

msgctxt "#30046"
msgid "Number of border rows/columns that will remain visible after zooming."
msgstr "Количество строк/столбцов рамки, которые останутся видимыми после масштабирования."

msgctxt "#30047"
msgid "20"
msgstr "20"

msgctxt "#30048"
msgid "Original or enhanced ROM for Enterprise. Enhanced version has faster memory test."
msgstr "Оригинальный или улучшенный ROM для Enterprise. Улучшенная версия имеет более быстрый тест памяти."

msgctxt "#30049"
msgid "Original"
